      "id": "d5a86d2b-f81d-4eb4-b9b2-658b48873c52",
      "name": "구글 시트에서 오늘자 선정 기사 읽기",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        820,
        240
      ],
      "credentials": {
        "googleApi": {
